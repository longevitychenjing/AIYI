# Chat model. The local Ollama service uses its native streaming API.
YIJING_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# Embedding provider, required when YIJING_RETRIEVER=qdrant
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Retrieval mode: sqlite uses the imported local corpus; qdrant adds semantic search
YIJING_RETRIEVER=sqlite
YIJING_KNOWLEDGE_DB=data/knowledge/yijing.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=yijing_sources
